{
  "manifest_version": 3,
  "name": "SPX - Auditoria Direta Google Sheets",
  "version": "4.5",
  "description": "Auditoria SPX: ignora Evento_1006 (Calculation Task) no Status Atual trazendo o status real anterior (ex: Missing)",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://spx.shopee.com.br/*",
    "https://*.shopee.com.br/*",
    "https://docs.google.com/spreadsheets/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auditar Planilha SPX"
  }
}
