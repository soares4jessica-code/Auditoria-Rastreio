{
  "manifest_version": 3,
  "name": "SPX - Auditoria Direta Google Sheets",
  "version": "4.4",
  "description": "Auditoria SPX enxuta: Coluna C direta e limpa, Coluna B com último status completo",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://spx.shopee.com.br/*",
    "https://*.shopee.com.br/*",
    "https://docs.google.com/spreadsheets/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auditar Planilha SPX"
  }
}
